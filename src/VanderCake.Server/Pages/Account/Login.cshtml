@page
@model VanderCake.Server.Pages.Account.LoginModel
@{ ViewData["Title"] = "Administrator login"; }
<div class="login-layout"><section class="login-intro"><p class="eyebrow">VANDERCAKE OPERATIONS</p><h1>Keep every order<br />moving forward.</h1><p>One workspace for customer portfolios, perishable stock, fulfillment and receivables.</p><div class="login-note"><strong>Built for the daily route.</strong><p>Review requests, allocate available stock and follow each sale through to payment.</p></div></section><section class="panel login-panel"><p class="eyebrow">SECURE ACCESS</p><h2>Administrator login</h2><p>Sign in with your administrator account.</p><div asp-validation-summary="All" role="alert"></div><form method="post"><input type="hidden" asp-for="ReturnUrl" /><label asp-for="Email">Email<input asp-for="Email" type="email" required autocomplete="username" placeholder="you@company.com" /></label><label asp-for="Password">Password<input asp-for="Password" required autocomplete="current-password" /></label><button>Log in</button></form><p class="hint">Need access? Contact the project administrator. Accounts are provisioned privately.</p></section></div>
