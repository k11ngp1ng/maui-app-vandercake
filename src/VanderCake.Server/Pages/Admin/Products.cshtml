@page
@model VanderCake.Server.Pages.Admin.ProductsModel
@{ ViewData["Title"] = "Product catalog"; }
<div class="page-heading"><div><p class="eyebrow">INVENTORY</p><h1>Product catalog</h1><p>Sale units, current prices and product groups.</p></div><a class="button" asp-page="Products">New product</a></div>
<form method="get" class="filters"><label for="q">Name or code</label><input id="q" name="q" value="@Request.Query["q"]" /><label for="groupId">Group</label><select id="groupId" name="groupId"><option value="">All groups</option>@foreach (var g in Model.Groups) { <option value="@g.Id" selected="@(Request.Query["groupId"] == g.Id.ToString())">@g.Name</option> }</select><button class="secondary">Filter</button><a asp-page="Products">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Product</th><th>Group</th><th>Sale unit</th><th>Price BRL</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (var p in Model.Products) { <tr><td><strong>@p.Name</strong><small class="block">@p.Code</small></td><td>@Model.Groups.FirstOrDefault(g => g.Id == p.ProductGroupId)?.Name</td><td>@p.SaleUnit</td><td>@p.Price.ToString("N2")</td><td><span class="badge">@(p.IsActive ? "Active" : "Inactive")</span></td><td><a asp-page="Products" asp-route-id="@p.Id">Edit</a></td></tr> }</tbody></table>@if (Model.Products.Count == 0) { <p class="empty">No products match these filters.</p> }</div><p class="hint">Catalog displays up to 500 records. <a asp-page="Groups">Manage groups</a> · <a asp-page="Stock">Inspect stock lots</a></p>
<h2>@(Model.Id.HasValue ? "Edit product" : "New product")</h2><p>Existing orders retain their submitted prices.</p>
<form method="post" class="panel form-grid"><div asp-validation-summary="All" role="alert"></div><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Version" />
<label asp-for="Form.Code">Product code<input asp-for="Form.Code" required maxlength="40" /></label><label asp-for="Form.Name">Product name<input asp-for="Form.Name" required maxlength="160" /></label>
<label asp-for="Form.GroupId">Group<select asp-for="Form.GroupId" required><option value="">Choose group</option>@foreach (var g in Model.Groups) { <option value="@g.Id">@g.Name</option> }</select></label>
<label asp-for="Form.SaleUnit">Sale unit<input asp-for="Form.SaleUnit" required maxlength="30" /></label><label asp-for="Form.Price">Unit price (BRL)<input asp-for="Form.Price" type="number" min="0.01" step="0.01" required /></label><label class="check"><input asp-for="Form.IsActive" /> Active product</label><div class="form-actions"><button>Save product</button><a asp-page="Products">Cancel</a></div></form>
