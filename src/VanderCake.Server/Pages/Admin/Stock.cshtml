@page
@model VanderCake.Server.Pages.Admin.StockModel
@{ ViewData["Title"] = "Stock & lots"; }
<p class="eyebrow">INVENTORY CONTROL</p><h1>Stock &amp; lots</h1><p>Valid stock must remain unexpired through the selected dispatch date. FEFO is applied on confirmation.</p>
<form method="get" class="filters"><label asp-for="DispatchDate">Dispatch date</label><input asp-for="DispatchDate" type="date" /><button class="secondary">Inspect</button><a asp-page="Stock">Today</a></form>
@if (Model.Stock.Count == 0) { <div class="empty">No stock records. Add a product, then receive a lot below.</div> }
@foreach (var p in Model.Stock) { <section class="panel"><div class="page-heading"><h2>@p.ProductName</h2><span class="badge">@p.EligibleQuantity eligible for @p.DispatchDate.ToString("dd MMM yyyy")</span></div><p>Physical: <strong>@p.PhysicalQuantity</strong> · Expired: <strong>@p.ExpiredQuantity</strong></p><div class="table-wrap"><table><thead><tr><th>Lot</th><th>Received</th><th>Expires</th><th>Available units</th><th>Eligibility</th></tr></thead><tbody>@foreach (var l in p.Lots) { <tr><td>@l.Code</td><td>@l.ReceivedDate.ToString("yyyy-MM-dd")</td><td>@l.ExpirationDate.ToString("yyyy-MM-dd")</td><td>@l.AvailableQuantity</td><td><span class="badge @(l.Eligible ? "good" : "warning")">@(l.Eligible ? "Eligible" : "Excluded")</span></td></tr> }</tbody></table></div></section> }
<h2>Receive stock</h2><p>Receipts add a new lot. Consumed balances cannot be edited.</p><form method="post" class="panel form-grid"><div asp-validation-summary="All" role="alert"></div><label asp-for="ProductId">Product<select asp-for="ProductId" required><option value="">Choose active product</option>@foreach (var p in Model.Products.Where(p => p.IsActive)) { <option value="@p.Id">@p.Name</option> }</select></label><label asp-for="Code">Lot code<input asp-for="Code" required maxlength="60" /></label><label asp-for="ReceivedDate">Received date<input asp-for="ReceivedDate" type="date" required /></label><label asp-for="ExpirationDate">Expiration date<input asp-for="ExpirationDate" type="date" required /></label><label asp-for="Quantity">Received units<input asp-for="Quantity" min="1" max="1000000" required /></label><div class="form-actions"><button>Receive lot</button></div></form>
