@page "{id:guid}"
@model VanderCake.Server.Pages.Admin.SaleModel
@{ ViewData["Title"] = "Sale details"; }
<a class="back" asp-page="Sales">← Sales</a><div class="page-heading"><div><p class="eyebrow">CONFIRMED SALE</p><h1>@Model.Sale.CustomerName</h1><p>@Model.Sale.SaleDate.ToString("dd MMM yyyy") · Term @Model.Sale.PaymentTermCode</p></div><strong class="total">R$ @((Model.Sale.TotalMinor / 100m).ToString("N2"))</strong></div><p><a asp-page="Order" asp-route-id="@Model.Sale.OrderId">Source order</a></p>
<div class="table-wrap"><table><thead><tr><th>Product</th><th>Fulfilled units</th><th>Unit price BRL</th><th>Total BRL</th></tr></thead><tbody>@foreach (var i in Model.Sale.Items) { <tr><td>@i.ProductName</td><td>@i.Quantity</td><td>@((i.UnitPriceMinor / 100m).ToString("N2"))</td><td>@((i.TotalMinor / 100m).ToString("N2"))</td></tr> }</tbody></table></div>
<h2>Generated installments</h2><div class="table-wrap"><table><thead><tr><th>Installment</th><th>Due date</th><th>Principal BRL</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (var a in Model.Sale.Installments) { <tr><td>@a.Number</td><td>@a.DueDate.ToString("dd MMM yyyy")</td><td>@((a.PrincipalMinor / 100m).ToString("N2"))</td><td><span class="badge">@a.Status</span></td><td><a asp-page="Payment" asp-route-id="@a.Id">@(a.Status == "Paid" ? "Payment receipt" : "Settle installment")</a></td></tr> }</tbody></table></div>
