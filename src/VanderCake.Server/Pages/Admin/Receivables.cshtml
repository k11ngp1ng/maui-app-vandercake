@page
@model VanderCake.Server.Pages.Admin.ReceivablesModel
@{ ViewData["Title"] = "Accounts receivable"; }
<p class="eyebrow">FINANCE</p><h1>Accounts receivable</h1><p>Review installment balances and register full settlement.</p>
<div class="summary-strip"><span>Open principal <strong>R$ @((Model.OpenPrincipal / 100m).ToString("N2"))</strong></span><span>Overdue principal <strong>R$ @((Model.OverduePrincipal / 100m).ToString("N2"))</strong></span><small>Totals cover the selected customer, or all customers; text and state filters affect the table only.</small></div>
<form method="get" class="filters"><input name="customerId" type="hidden" value="@Request.Query["customerId"]" /><label for="q">Customer name</label><input name="q" id="q" value="@Request.Query["q"]" /><label for="status">Status</label><select name="status" id="status"><option value="">All states</option>@foreach (var s in new[] { "Open", "Overdue", "Paid" }) { <option selected="@(Request.Query["status"] == s)">@s</option> }</select><button class="secondary">Filter</button><a asp-page="Receivables">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Customer / installment</th><th>Due date</th><th>Status</th><th>Principal BRL</th><th>Payable today BRL</th><th>Action</th></tr></thead><tbody>@foreach (var a in Model.Accounts) { <tr><td><strong>@a.CustomerName</strong><small class="block">Installment @a.Number · <a asp-page="Sale" asp-route-id="@a.SaleId">Source sale</a></small></td><td>@a.DueDate.ToString("dd MMM yyyy")</td><td><span class="badge @(a.Status == "Overdue" ? "warning" : a.Status == "Paid" ? "good" : "")">@a.Status</span></td><td>@((a.PrincipalMinor / 100m).ToString("N2"))</td><td>@((a.PayableMinor / 100m).ToString("N2"))</td><td><a asp-page="Payment" asp-route-id="@a.Id">@(a.Status == "Paid" ? "Payment history" : "Settle installment")</a></td></tr> }</tbody></table>@if (Model.Accounts.Count == 0) { <div class="empty"><h2>No installments to show</h2><p>Change the filters or confirm an allocation to generate receivables.</p></div> }</div>
