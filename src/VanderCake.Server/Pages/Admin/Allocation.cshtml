@page "{id:guid}"
@model VanderCake.Server.Pages.Admin.AllocationModel
@{ ViewData["Title"] = "Allocate order"; }
<a class="back" asp-page="Orders">← Orders</a><p class="eyebrow">SINGLE ORDER FULFILLMENT</p><h1>Allocate @Model.Order?.CustomerName</h1><p><a asp-page="Allocations">Use the multi-order workspace for live aggregate stock validation →</a></p><div asp-validation-summary="All" role="alert"></div>
@if (Model.Order is not null && Model.Order.Status == "Submitted") {
<form method="post" class="panel"><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="RequestKey" /><div class="form-grid"><label asp-for="DispatchDate">Dispatch date<input type="date" asp-for="DispatchDate" required /></label><label asp-for="DispatchHour">Dispatch window<select asp-for="DispatchHour"><option value="12">12:00</option><option value="19">19:00</option></select></label></div>
<div class="table-wrap"><table><thead><tr><th>Product</th><th>Requested</th><th>Fulfill</th></tr></thead><tbody>@for (var i = 0; i < Model.Items.Count; i++) { var line = Model.Order.Items.SingleOrDefault(x => x.Id == Model.Items[i].OrderItemId); <tr><td>@line?.ProductName<input type="hidden" asp-for="Items[i].OrderItemId" /></td><td>@line?.RequestedQuantity</td><td><label class="sr-only" asp-for="Items[i].FulfilledQuantity">Fulfilled units for @line?.ProductName</label><input type="number" asp-for="Items[i].FulfilledQuantity" min="0" max="@line?.RequestedQuantity" step="1" required /></td></tr> }</tbody></table></div>
<p>Enter approved quantities explicitly. Unfulfilled units close as shortages. Zero fulfillment closes the order without a sale.</p><div class="form-actions"><button>Confirm allocation and generate sale</button><a asp-page="Orders">Cancel</a></div></form>
<h2>Stock by lot</h2><p>Eligibility uses the loaded dispatch date. After changing dates, use the multi-order workspace to refresh availability. The server revalidates all stock on confirmation.</p>
@foreach (var s in Model.Stock) { <section class="panel"><h3>@s.ProductName <span class="badge">@s.EligibleQuantity eligible units</span></h3><div class="table-wrap"><table><thead><tr><th>Lot</th><th>Expires</th><th>Available units</th><th>Eligibility</th></tr></thead><tbody>@foreach (var l in s.Lots) { <tr><td>@l.Code</td><td>@l.ExpirationDate.ToString("dd MMM yyyy")</td><td>@l.AvailableQuantity</td><td><span class="badge @(l.Eligible ? "good" : "warning")">@(l.Eligible ? "Eligible" : "Excluded")</span></td></tr> }</tbody></table></div></section> }
} else { <section class="empty"><h2>This order is finalized</h2><p>Its quantities cannot be edited.</p><a asp-page="Sales">Review sales</a></section> }
