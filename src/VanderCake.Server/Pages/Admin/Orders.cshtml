@page
@model VanderCake.Server.Pages.Admin.OrdersModel
@{ ViewData["Title"] = "Orders"; }
<div class="page-heading"><div><p class="eyebrow">ORDER FULFILLMENT</p><h1>Orders</h1><p>Review requests and decide how available stock is distributed.</p></div><a class="button" asp-page="Allocations">Allocate multiple orders</a></div>
<form method="get" class="filters"><label for="q">Customer</label><input name="q" id="q" value="@Request.Query["q"]" /><label for="status">Status</label><select name="status" id="status">@foreach (var s in new[] { "Submitted", "All", "Fulfilled", "PartiallyFulfilled", "Cut" }) { <option selected="@(Request.Query["status"] == s)">@s</option> }</select><button class="secondary">Filter</button><a asp-page="Orders">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Customer</th><th>Dispatch</th><th>Requested BRL</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (var o in Model.Orders) { <tr><td><strong>@o.CustomerName</strong><small class="block">@o.Items.Count product line(s) · Term @o.PaymentTermCode</small></td><td>@o.DispatchDate.ToString("dd MMM yyyy")<small class="block">@(o.DispatchHour):00</small></td><td>@((o.RequestedTotalMinor / 100m).ToString("N2"))</td><td><span class="badge @(o.Status == "Submitted" ? "warning" : "good")">@o.Status</span></td><td><a asp-page="Order" asp-route-id="@o.Id">View details</a>@if (o.Status == "Submitted") { <a class="block" asp-page="Allocation" asp-route-id="@o.Id">Allocate quantities</a> }</td></tr> }</tbody></table>@if (Model.Orders.Count == 0) { <div class="empty"><h2>No orders to show</h2><p>Change the filters or wait for a salesperson to submit an order.</p></div> }</div><p class="hint">Order list displays up to 500 records.</p>
