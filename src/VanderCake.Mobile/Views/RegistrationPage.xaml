<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:VanderCake.Mobile.ViewModels" xmlns:views="clr-namespace:VanderCake.Mobile.Views" x:Class="VanderCake.Mobile.Views.RegistrationPage" x:DataType="vm:RegistrationViewModel" Title="Register customer">
<ScrollView><VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="700"><Label Text="Register a customer" Style="{StaticResource Heading}" /><Label Text="The server assigns this customer to your portfolio." Style="{StaticResource Caption}" /><views:FeedbackView /><VerticalStackLayout IsEnabled="{Binding IsIdle}" Spacing="12"><Label Text="Customer name" /><Entry Text="{Binding Name}" MaxLength="160" Placeholder="Business name" SemanticProperties.Description="Customer name" /><Label Text="State" /><Picker ItemsSource="{Binding States}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedState}" Title="Choose state" /><Label Text="City" /><Picker ItemsSource="{Binding Cities}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCity}" Title="Choose city" /><Label Text="Visit sequence" /><Entry Text="{Binding VisitOrder}" Keyboard="Numeric" SemanticProperties.Description="Visit sequence" /><Label Text="Address" /><Entry Text="{Binding Address}" MaxLength="240" Placeholder="Street and number" SemanticProperties.Description="Customer address" /><Label Text="Phone" /><Entry Text="{Binding Phone}" Keyboard="Telephone" MaxLength="30" SemanticProperties.Description="Customer phone" /><Button Text="Register customer" Command="{Binding SaveCommand}" /></VerticalStackLayout></VerticalStackLayout></ScrollView>
</ContentPage>
