<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:VanderCake.Mobile.ViewModels" xmlns:views="clr-namespace:VanderCake.Mobile.Views" x:Class="VanderCake.Mobile.Views.LoginPage" x:DataType="vm:LoginViewModel" Title="VanderCake · Sign in" Shell.FlyoutBehavior="Disabled">
<ScrollView><VerticalStackLayout Padding="24,32" Spacing="18" MaximumWidthRequest="560" HorizontalOptions="Fill"><Label Text="VANDERCAKE / SALESPERSON" TextColor="{StaticResource Primary}" FontSize="12" /><Label Text="Your customer route, connected." Style="{StaticResource Heading}" /><Label Text="Sign in to manage your portfolio and submit orders." Style="{StaticResource Caption}" /><views:FeedbackView /><VerticalStackLayout Spacing="12" IsEnabled="{Binding IsIdle}"><Label Text="Email" /><Entry Text="{Binding Email}" Keyboard="Email" Placeholder="you@company.com" AutomationId="LoginEmail" SemanticProperties.Description="Salesperson email" /><Label Text="Password" /><Entry Text="{Binding Password}" IsPassword="True" Placeholder="Your password" AutomationId="LoginPassword" SemanticProperties.Description="Password" /><Button Text="Sign in" Command="{Binding LoginCommand}" AutomationId="SignIn" /><Label Text="API server (HTTPS)" /><Entry Text="{Binding Address}" Keyboard="Url" Placeholder="https://your-server" AutomationId="ApiAddress" SemanticProperties.Description="API server address" /><Label Text="Windows: localhost. Android emulator: 10.0.2.2. Physical devices need a reachable server address." Style="{StaticResource Caption}" /><VerticalStackLayout IsVisible="{Binding IsDevelopment}" Spacing="8"><Label Text="Local development certificate SHA-256 (optional)" /><Entry Text="{Binding DevelopmentPin}" Placeholder="Public certificate fingerprint" SemanticProperties.Description="Debug local certificate fingerprint" /><Label Text="Debug only. Explicitly pins a localhost certificate for localhost or 10.0.2.2. Release always uses normal TLS validation." Style="{StaticResource Caption}" /></VerticalStackLayout></VerticalStackLayout><Label Text="No shared password is shipped. Ask the administrator to provision your account." Style="{StaticResource Caption}" /></VerticalStackLayout></ScrollView>
</ContentPage>
