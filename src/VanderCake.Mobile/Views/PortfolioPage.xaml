<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:VanderCake.Mobile.ViewModels" xmlns:api="clr-namespace:VanderCake.Contracts.Api;assembly=VanderCake.Contracts" xmlns:views="clr-namespace:VanderCake.Mobile.Views" x:Class="VanderCake.Mobile.Views.PortfolioPage" x:Name="Page" x:DataType="vm:PortfolioViewModel" Title="Customer portfolio">
<ContentPage.ToolbarItems><ToolbarItem Text="Orders" Command="{Binding OrdersCommand}" /><ToolbarItem Text="Sign out" Command="{Binding LogoutCommand}" /></ContentPage.ToolbarItems>
<Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14" MaximumWidthRequest="1100"><VerticalStackLayout Spacing="6"><Label Text="Your customer portfolio" Style="{StaticResource Heading}" /><Label Text="Assigned customers in visit sequence. Refresh to see portfolio changes." Style="{StaticResource Caption}" /></VerticalStackLayout><views:FeedbackView Grid.Row="1" /><Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12"><SearchBar Text="{Binding Search}" Placeholder="Search customer name" SemanticProperties.Description="Search portfolio" /><Button Grid.Column="1" Text="Register customer" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsIdle}" /></Grid><RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}"><CollectionView ItemsSource="{Binding Customers}" SelectionMode="None"><CollectionView.EmptyView><Label Text="No customers to show. Refresh, clear the search or register a customer." Margin="20" /></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="api:CustomerResponse"><Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14"><Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" /><Label Grid.Row="1" Text="{Binding VisitOrder, StringFormat='Visit sequence {0}'}" /><Label Grid.Row="2" Text="{Binding Address}" Style="{StaticResource Caption}" /><Button Grid.Column="1" Grid.RowSpan="3" Text="Details" Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCustomerCommand, x:DataType={x:Null}}" CommandParameter="{Binding .}" /></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></RefreshView></Grid>
</ContentPage>
