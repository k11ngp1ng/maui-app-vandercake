<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:VanderCake.Mobile.ViewModels" x:Class="VanderCake.Mobile.Views.FeedbackView" x:DataType="vm:PageViewModel">
<VerticalStackLayout Spacing="8"><HorizontalStackLayout Spacing="12" IsVisible="{Binding IsBusy}"><ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" /><Label Text="Connecting to server…" VerticalOptions="Center" /><Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Secondary}" /></HorizontalStackLayout><Border IsVisible="{Binding HasError}" Padding="14" BackgroundColor="#FFF0ED" Stroke="#E9C0B9" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="10"><Label Text="{Binding Error}" TextColor="#842E25" SemanticProperties.Description="Request error" /><Button Text="Retry / refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource Secondary}" /></VerticalStackLayout></Border><Label Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextColor="{StaticResource Primary}" /></VerticalStackLayout>
</ContentView>
