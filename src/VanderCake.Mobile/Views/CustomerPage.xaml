<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:VanderCake.Mobile.ViewModels" xmlns:views="clr-namespace:VanderCake.Mobile.Views" x:Class="VanderCake.Mobile.Views.CustomerPage" x:DataType="vm:CustomerViewModel" Title="Customer details">
<ContentPage.ToolbarItems><ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" /></ContentPage.ToolbarItems><ScrollView><VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="900"><views:FeedbackView /><Label Text="{Binding Customer.Name}" Style="{StaticResource Heading}" /><Label Text="{Binding Customer.VisitOrder, StringFormat='Visit sequence {0}'}" /><Label Text="{Binding Customer.Address}" /><Label Text="{Binding Customer.Phone}" /><Label Text="{Binding Customer.IsActive, StringFormat='Active customer: {0}'}" Style="{StaticResource Caption}" /><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="10"><Label Text="Customer debt" Style="{StaticResource SectionTitle}" /><Label Text="{Binding Balance.OpenPrincipalMinor, Converter={StaticResource Money}, StringFormat='Open principal: {0}'}" /><Label Text="{Binding Balance.OverduePrincipalMinor, Converter={StaticResource Money}, StringFormat='Overdue principal: {0}'}" /><Label Text="{Binding Balance.PayableMinor, Converter={StaticResource Money}, StringFormat='Payable today: {0}'}" FontFamily="OpenSansSemibold" /><Label Text="{Binding Balance.AsOfDate, StringFormat='Server quote date: {0:yyyy-MM-dd}'}" Style="{StaticResource Caption}" /></VerticalStackLayout></Border><Button Text="New order" Command="{Binding NewOrderCommand}" IsEnabled="{Binding IsIdle}" /><Button Text="Previous purchases" Command="{Binding PurchasesCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource Secondary}" /></VerticalStackLayout></ScrollView>
</ContentPage>
