<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:VanderCake.Mobile.ViewModels" xmlns:api="clr-namespace:VanderCake.Contracts.Api;assembly=VanderCake.Contracts" xmlns:views="clr-namespace:VanderCake.Mobile.Views" x:Class="VanderCake.Mobile.Views.OrderPage" x:DataType="vm:OrderViewModel" Title="Order status">
<ContentPage.ToolbarItems><ToolbarItem Text="Refresh status" Command="{Binding RefreshCommand}" /></ContentPage.ToolbarItems><ScrollView><VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="900"><views:FeedbackView /><Label Text="{Binding Order.CustomerName}" Style="{StaticResource Heading}" /><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="10"><Label Text="{Binding Order.Status, StringFormat='Status: {0}'}" Style="{StaticResource SectionTitle}" TextColor="{StaticResource Primary}" /><Label Text="{Binding Order.Id, StringFormat='Order: {0}'}" Style="{StaticResource Caption}" /><Label Text="{Binding Order.DispatchDate, StringFormat='Dispatch: {0:dd MMM yyyy}'}" /><Label Text="{Binding Order.DispatchHour, StringFormat='Window: {0}:00'}" /><Label Text="{Binding Order.PaymentTermCode, StringFormat='Payment term code: {0}'}" /><Label Text="{Binding Order.RequestedTotalMinor, Converter={StaticResource Money}, StringFormat='Server requested total: {0}'}" /><Label Text="Submitted means awaiting allocation. Fulfilled, PartiallyFulfilled and Cut are finalized. Submitted orders cannot be edited." Style="{StaticResource Caption}" /></VerticalStackLayout></Border><Label Text="Requested and fulfilled quantities" Style="{StaticResource SectionTitle}" /><VerticalStackLayout BindableLayout.ItemsSource="{Binding Order.Items}" Spacing="12"><BindableLayout.ItemTemplate><DataTemplate x:DataType="api:OrderItemResponse"><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="6"><Label Text="{Binding ProductName}" FontFamily="OpenSansSemibold" /><Label Text="{Binding RequestedQuantity, StringFormat='Requested: {0} units'}" /><Label Text="{Binding FulfilledQuantity, StringFormat='Fulfilled: {0} units'}" /><Label Text="{Binding UnfulfilledQuantity, StringFormat='Not fulfilled: {0} units'}" /><Label Text="{Binding UnitPriceMinor, Converter={StaticResource Money}, StringFormat='Submitted unit price: {0}'}" Style="{StaticResource Caption}" /></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></ScrollView>
</ContentPage>
