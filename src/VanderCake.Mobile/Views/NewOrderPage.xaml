<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:VanderCake.Mobile.ViewModels" xmlns:views="clr-namespace:VanderCake.Mobile.Views" x:Class="VanderCake.Mobile.Views.NewOrderPage" x:DataType="vm:NewOrderViewModel" Title="New order">
<ScrollView><VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="900"><Label Text="New order" Style="{StaticResource Heading}" /><Label Text="{Binding Customer.Name}" Style="{StaticResource SectionTitle}" /><views:FeedbackView /><Label Text="Enter whole sale units. Zero leaves a product out of the order. Prices and availability are confirmed by the server." Style="{StaticResource Caption}" /><VerticalStackLayout IsEnabled="{Binding IsEditable}" Spacing="14"><VerticalStackLayout BindableLayout.ItemsSource="{Binding Products}" Spacing="12"><BindableLayout.EmptyView><Label Text="No products loaded. Refresh after checking your connection." /></BindableLayout.EmptyView><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:ProductQuantity"><Border Style="{StaticResource Card}"><Grid ColumnDefinitions="*,110" ColumnSpacing="16"><VerticalStackLayout Spacing="5"><Label Text="{Binding Product.Name}" Style="{StaticResource SectionTitle}" /><Label Text="{Binding Product.SaleUnit, StringFormat='Sale unit: {0}'}" Style="{StaticResource Caption}" /><Label Text="{Binding Product.PriceMinor, Converter={StaticResource Money}, StringFormat='Current unit price: {0}'}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Units" Style="{StaticResource Caption}" /><Entry Text="{Binding Quantity}" Keyboard="Numeric" SemanticProperties.Description="{Binding Product.Name, StringFormat='Requested units for {0}'}" /></VerticalStackLayout></Grid></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout><Label Text="Payment terms" /><Picker ItemsSource="{Binding Terms}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedTerm}" Title="Choose payment terms" /><Label Text="Dispatch date (São Paulo)" /><DatePicker Date="{Binding DispatchDate}" Format="dd MMM yyyy" /><Label Text="Dispatch window" /><Picker ItemsSource="{Binding Windows}" SelectedItem="{Binding DispatchWindow}" Title="Choose dispatch window" /></VerticalStackLayout><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="10"><Label Text="{Binding Estimate}" Style="{StaticResource SectionTitle}" /><Label Text="This is a preview using the loaded catalog. The submitted order uses the server's current prices." Style="{StaticResource Caption}" /><Button Text="Submit / retry same order" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsIdle}" AutomationId="SubmitOrder" /><Button Text="Unlock after reconciling order history" Command="{Binding ResetCommand}" IsVisible="{Binding HasPendingSubmission}" IsEnabled="{Binding IsIdle}" Style="{StaticResource Secondary}" /></VerticalStackLayout></Border></VerticalStackLayout></ScrollView>
</ContentPage>
