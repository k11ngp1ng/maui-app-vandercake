<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:VanderCake.Mobile.ViewModels" xmlns:api="clr-namespace:VanderCake.Contracts.Api;assembly=VanderCake.Contracts" xmlns:views="clr-namespace:VanderCake.Mobile.Views" x:Class="VanderCake.Mobile.Views.OrdersPage" x:Name="Page" x:DataType="vm:OrdersViewModel" Title="Order history">
<ContentPage.ToolbarItems><ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" /></ContentPage.ToolbarItems><Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14" MaximumWidthRequest="1100"><Label Text="Order history" Style="{StaticResource Heading}" /><views:FeedbackView Grid.Row="1" /><Picker Grid.Row="2" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Filter}" Title="Filter status" /><CollectionView Grid.Row="3" ItemsSource="{Binding Orders}" SelectionMode="None"><CollectionView.EmptyView><Label Text="No orders match this status. Refresh to check for recent submissions." Margin="20" /></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="api:OrderResponse"><Border Style="{StaticResource Card}" Margin="0,0,0,12"><VerticalStackLayout Spacing="8"><Label Text="{Binding CustomerName}" Style="{StaticResource SectionTitle}" /><Label Text="{Binding Status, StringFormat='Status: {0}'}" TextColor="{StaticResource Primary}" /><Label Text="{Binding DispatchDate, StringFormat='Dispatch: {0:dd MMM yyyy}'}" /><Label Text="{Binding DispatchHour, StringFormat='Window: {0}:00'}" Style="{StaticResource Caption}" /><Label Text="{Binding RequestedTotalMinor, Converter={StaticResource Money}, StringFormat='Requested total: {0}'}" /><Button Text="View order" Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCommand, x:DataType={x:Null}}" CommandParameter="{Binding .}" Style="{StaticResource Secondary}" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</ContentPage>
