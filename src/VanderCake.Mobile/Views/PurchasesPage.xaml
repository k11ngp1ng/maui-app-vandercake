<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:VanderCake.Mobile.ViewModels" xmlns:api="clr-namespace:VanderCake.Contracts.Api;assembly=VanderCake.Contracts" xmlns:views="clr-namespace:VanderCake.Mobile.Views" x:Class="VanderCake.Mobile.Views.PurchasesPage" x:DataType="vm:PurchasesViewModel" Title="Previous purchases">
<ContentPage.ToolbarItems><ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" /></ContentPage.ToolbarItems><Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="16" MaximumWidthRequest="1100"><Label Text="Previous purchases" Style="{StaticResource Heading}" /><views:FeedbackView Grid.Row="1" /><CollectionView Grid.Row="2" ItemsSource="{Binding Purchases}" SelectionMode="None"><CollectionView.EmptyView><Label Text="No confirmed purchases to show. Submitted orders appear in order history." Margin="20" /></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="api:SaleResponse"><Border Style="{StaticResource Card}" Margin="0,0,0,14"><VerticalStackLayout Spacing="12"><Label Text="{Binding SaleDate, StringFormat='Sale · {0:dd MMM yyyy}'}" Style="{StaticResource SectionTitle}" /><Label Text="{Binding TotalMinor, Converter={StaticResource Money}, StringFormat='Confirmed total: {0}'}" /><VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="12"><BindableLayout.ItemTemplate><DataTemplate x:DataType="api:SaleItemResponse"><VerticalStackLayout Spacing="4"><Label Text="{Binding ProductName}" FontFamily="OpenSansSemibold" /><Label Text="{Binding Quantity, StringFormat='Purchased units: {0}'}" /><Label Text="{Binding UnitPriceMinor, Converter={StaticResource Money}, StringFormat='Historical unit price: {0}'}" Style="{StaticResource Caption}" /><Label Text="{Binding TotalMinor, Converter={StaticResource Money}, StringFormat='Line total: {0}'}" /></VerticalStackLayout></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</ContentPage>
