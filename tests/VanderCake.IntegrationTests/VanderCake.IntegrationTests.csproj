<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Exercise the exact platform-neutral client/VM sources without requiring a UI runtime in xUnit. -->
    <Compile Include="..\..\src\VanderCake.Mobile\Client\*.cs" Link="Mobile\Client\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\VanderCake.Mobile\ViewModels\*.cs" Link="Mobile\ViewModels\%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <ProjectReference Include="..\..\src\VanderCake.Server\VanderCake.Server.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

